  {
    "id": "1cb3b03c3cb19db6",
    "type": "function",
    "z": "4754c21c18e3aa6a",
    "name": "Prepare Flask API Request",
    "func": "// Prepare request for local Flask ML Hybrid API\n// Make sure Flask is running at http://127.0.0.1:5000\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.method = \"POST\";\nmsg.url = \"http://127.0.0.1:5000/predict\";\n\n// HTTP request node sends the payload as request body\nmsg.payload = JSON.stringify(msg.payload);\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
