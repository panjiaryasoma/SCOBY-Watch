  {
    "id": "29d616431328088a",
    "type": "function",
    "z": "4754c21c18e3aa6a",
    "name": "Split API Response to Dashboard",
    "func": "let d = msg.payload;\n\n// If the HTTP Request node returns a JSON string, parse it.\nif (typeof d === \"string\") {\n    try {\n        d = JSON.parse(d);\n    } catch (err) {\n        node.error(\"Invalid API response JSON: \" + err.message, msg);\n        return null;\n    }\n}\n\nfunction safeNumber(value, fallback = 0) {\n    const n = Number(value);\n    return Number.isFinite(n) ? n : fallback;\n}\n\nfunction safeText(value, fallback = \"N/A\") {\n    return value === undefined || value === null || value === \"\" ? fallback : String(value);\n}\n\nconst mlConfidence = d.ml_confidence !== undefined && d.ml_confidence !== null\n    ? Number(d.ml_confidence).toFixed(4)\n    : \"N/A\";\n\nreturn [\n    { payload: safeNumber(d.room_temp_c), topic: \"Temperature\" },\n    { payload: safeNumber(d.room_temp_c), topic: \"Temperature\" },\n\n    { payload: safeNumber(d.humidity_percent), topic: \"Humidity\" },\n    { payload: safeNumber(d.humidity_percent), topic: \"Humidity\" },\n\n    { payload: safeNumber(d.ph), topic: \"pH\" },\n    { payload: safeNumber(d.ph), topic: \"pH\" },\n\n    { payload: safeNumber(d.brix), topic: \"Brix\" },\n    { payload: safeNumber(d.brix), topic: \"Brix\" },\n\n    { payload: safeText(d.batch_id) },\n    { payload: safeText(d.recipe_id) + \" / \" + safeText(d.tea_type) },\n    { payload: safeText(d.day) },\n\n    { payload: safeText(d.rule_status) },\n    { payload: safeText(d.ml_status) },\n    { payload: mlConfidence },\n    { payload: safeText(d.final_status) },\n    { payload: safeText(d.risk_flag) },\n    { payload: safeText(d.rule_triggered) },\n    { payload: safeText(d.decision_reason) },\n    { payload: safeText(d.recommendation) },\n\n    { payload: d }\n];",
    "outputs": 20,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
