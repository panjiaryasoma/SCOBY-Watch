# Normalize text files across Windows, Linux, and macOS.
* text=auto

# Source code and configuration.
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.cff     text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.sh      text eol=lf
*.ino     text eol=lf
*.svg     text eol=lf

# Documentation and generated text data.
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.ipynb   text eol=lf

# Windows scripts retain Windows line endings.
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary model and media artifacts.
*.pkl     binary
*.joblib  binary
*.npy     binary
*.npz     binary

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary

*.pdf     binary
*.zip     binary
*.docx    binary
*.pptx    binary
*.xlsx    binary
